name: APK (build on demand)

# Owner request: build an installable APK when asked, and only when asked. The branch check
# (analyze-test.yml) stays analyze + tests with no build, so a push never waits for Gradle.
# Run it from Actions → "APK (build on demand)" → Run workflow, or:
#   gh workflow run apk.yml --ref main
#
# The APK is published as a RELEASE ASSET, never through actions/upload-artifact: this account's
# artifact storage quota is full, and an upload there fails the run *after* a good build
# ("Failed to CreateArtifact: Artifact storage quota has been hit"). A release asset also gives a
# plain download link that can be opened on the phone, which is what an APK is for.

on:
  workflow_dispatch:
    inputs:
      variant:
        description: 'release or debug'
        type: choice
        options: [release, debug]
        default: release
      opencode:
        description: 'Bundle the opencode engine (the app''s engine — leave on; off only for a diagnostic build)'
        type: boolean
        default: true

permissions:
  contents: write # publish the release and its assets

concurrency:
  group: apk-${{ github.ref }}-${{ inputs.variant }}
  cancel-in-progress: true

jobs:
  apk:
    runs-on: ubuntu-latest
    timeout-minutes: 60
    steps:
      - uses: actions/checkout@v4

      # The opencode runtime is ~220 MB unpacked and Gradle copies native libs several times; the stock runner ran
      # out of disk ("No space left on device", run 41428610744). Drop toolchains this build never uses.
      - name: Free disk (opencode builds)
        if: ${{ inputs.opencode }}
        run: |
          df -h /
          sudo rm -rf /usr/share/dotnet /usr/local/lib/node_modules /opt/ghc /usr/local/.ghcup /usr/share/swift \
            /usr/local/share/boost /opt/hostedtoolcache/CodeQL /usr/local/share/powershell /usr/share/miniconda \
            /usr/local/julia* /opt/az /usr/share/az_* /usr/local/share/chromium /opt/microsoft || true
          sudo docker image prune -af >/dev/null 2>&1 || true
          df -h /

      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - uses: subosito/flutter-action@v2
        with:
          flutter-version: '3.47.8'
          channel: stable
          cache: true

      # A new signing key silently breaks every future update (Android refuses a cross-key
      # install), so refuse to build if the keystore is not the pinned Telesia key.
      - name: Pinned signing key (never regenerate — a new key breaks updates)
        run: |
          test -f keys/debug.keystore || { echo "::error::keys/debug.keystore missing — refusing to sign with a new key"; exit 1; }
          keytool -list -v -keystore keys/debug.keystore -storepass android | grep -E "SHA256" | tee /tmp/k.txt
          grep -qi "4D:6D:11:6E" /tmp/k.txt || { echo "::error::keystore is not the pinned Telesia key"; exit 1; }

      # android/ and ios/ are gitignored; the tracked native code lives in android_native/ and is
      # stamped in by tools/patch_android.py (same as analyze-test.yml).
      - name: Generate platform folders
        run: |
          flutter create --org com.telesia --project-name agent --platforms android,ios .
          rm -f test/widget_test.dart

      - name: Make it Telesia (manifest, native code, resources, gradle, signing)
        run: python3 tools/patch_android.py

      - run: flutter pub get

      # opencode on the phone (2026-11-02): the linux-arm64-musl server, musl's loader and the two C++ runtime libs,
      # renamed lib*.so so Android extracts them to nativeLibraryDir (the only place an app may execute from).
      # android_native/OpenCode.kt starts libocld.so (the loader) 